# Copy to .env for local development. Real values live only in the Render dashboard (docs/02 §9.3).
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret with the Node API (32+ random bytes). Every /internal/* request must send it.
AI_INTERNAL_KEY=

# Read-only MongoDB user, schemes collection only (Sahayak grounding, Phase 4G). Include the
# database name in the path, e.g. mongodb+srv://ai-ro:...@cluster/suraksha_setu
MONGODB_URI_READONLY=

# LLM provider adapter (Phase 4G): gemini (default) | anthropic | fake (offline, dev/E2E only)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Empty = provider default (gemini-3.5-flash). Set a budget alert in the provider console.
LLM_MODEL=
LLM_TIMEOUT_S=12

# Path to the float16 LiteRT model (downloaded at build time, never committed). model_card.json
# must sit next to it. Without a model, /internal/classify answers 503 and the app falls back to
# manual categories.
MODEL_PATH=models/civic_cnn_v1.tflite
# Release assets to download at build time (scripts/fetch_model.py)
MODEL_URL=
MODEL_CARD_URL=

# Hosts the classifier may fetch photos from (comma-separated). Add localhost for local dev.
AI_ALLOWED_IMAGE_HOSTS=res.cloudinary.com,localhost,127.0.0.1
