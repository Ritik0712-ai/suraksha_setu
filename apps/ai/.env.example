# Copy to .env for local development. Real values live only in the Render dashboard (docs/02 §9.3).
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret with the Node API (32+ random bytes). Every /internal/* request must send it.
AI_INTERNAL_KEY=

# Read-only MongoDB user, schemes collection only (Sahayak grounding, Phase 4G)
MONGODB_URI_READONLY=

# LLM provider adapter (Phase 4G). Default: Google Gemini Flash-tier.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# Path to the float16 LiteRT model (downloaded at build time, never committed)
MODEL_PATH=models/civic_cnn_v1.tflite
