# Copy to .env.local for local development (docs/02 §9.3).
# API calls go through the same-origin /api rewrite (Vite proxy locally, Vercel rewrite in prod).
VITE_API_BASE=/api/v1
VITE_SOCKET_URL=http://localhost:5000
# Browser key, restricted by HTTP referrer
VITE_GOOGLE_MAPS_KEY=
VITE_APP_ENV=local
