# Copy to .env for local development. Real values live only in the Render dashboard (docs/02 §9.3).
NODE_ENV=development
# bcrypt cost; keep 12 (production refuses anything lower)
BCRYPT_COST=12
PORT=5000

# MongoDB Atlas (dev project). Use a separate Atlas project for prod.
MONGODB_URI=mongodb://127.0.0.1:27017/suraksha_setu_dev

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Public URL of the web app (used in SOS track links and emails)
PUBLIC_APP_URL=http://localhost:5173

# Cloudinary (cloudinary://<key>:<secret>@<cloud>). Leave empty locally: photos are then saved
# in apps/api/.uploads and served by the API at API_PUBLIC_URL/api/v1/files/<name>.
CLOUDINARY_URL=
API_PUBLIC_URL=http://localhost:5000

# SMTP (Gmail app password; Brevo as backup)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Suraksha Setu <no-reply@example.com>"
# Brevo HTTPS email API (free, 300/day) — tried after the relay. Render's free plan
# blocks outbound SMTP ports; SMTP below still works locally.
BREVO_API_KEY=
# Free Gmail relay (Apps Script web app, see mail-relay/Code.gs and docs/runbook.md §1.3);
# tried first when both are set
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
# Backup SMTP (Brevo: smtp-relay.brevo.com, port 587), used only if the primary fails
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=

# Django AI service (internal only)
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_KEY=

# Google Places (server key, API-restricted to "Places API (New)"; never the browser Maps key)
GOOGLE_PLACES_KEY=
# Hard stop on billed Places calls per IST day (also set a quota + budget alert in Cloud Console)
PLACES_DAILY_LIMIT=300

# development | preview | production — keeps Cloudinary folders apart (defaults to NODE_ENV)
APP_ENV=
