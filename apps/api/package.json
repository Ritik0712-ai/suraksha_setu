{
  "name": "@suraksha/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "db:indexes": "node --env-file-if-exists=.env src/scripts/db-indexes.js",
    "db:migrate": "migrate-mongo up -f migrate-mongo-config.js",
    "db:migrate:status": "migrate-mongo status -f migrate-mongo-config.js",
    "db:migrate:create": "migrate-mongo create -f migrate-mongo-config.js",
    "db:seed": "node --env-file-if-exists=.env src/scripts/db-seed.js",
    "db:seed:admins": "node --env-file-if-exists=.env src/scripts/db-seed-admins.js",
    "db:seed:schemes": "node --env-file-if-exists=.env src/scripts/db-seed-schemes.js",
    "db:seed:emergency": "node --env-file-if-exists=.env src/scripts/db-seed-emergency.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
}
